{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "@halext/tui#typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.opencode/themes/hcode-ghostty.json"]
    },
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@halext/tui#build": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.opencode/themes/hcode-ghostty.json"],
      "outputs": ["dist/**"]
    },
    "@halext/bridge#test": {
      "outputs": []
    },
    "@halext/tui#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.opencode/themes/hcode-ghostty.json",
        "$TURBO_ROOT$/ghostty/hcode-ghostty.conf"
      ],
      "outputs": []
    },
    "opencode#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode-ai/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
