{
  "name": "@halext/bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src/*.test.ts",
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "rm -rf ./dist && bun build ./src/server.ts --outdir ./dist --target bun"
  },
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@vscode/windows-process-tree": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  }
}
