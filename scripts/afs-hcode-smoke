#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
dir="$ROOT"
live="${HCODE_SMOKE_LIVE:-0}"
afs_root="${AFS_ROOT:-${SC_WORKSPACE_ROOT:-$HOME/src}/lab/afs}"
afs_cli="${AFS_BIN:-${AFS_CLI:-$afs_root/scripts/afs}}"

if [[ "${1:-}" == "--live-run" ]]; then
  live="1"
  shift
fi

if [[ $# -gt 0 ]]; then
  dir="$1"
fi
target="$dir"

# Run against a disposable v2 context and an isolated home. This keeps the
# smoke deterministic in CI and prevents test artifacts from reaching the
# operator's real context, registry, or OpenCode config.
fixture="$(mktemp -d "${TMPDIR:-/tmp}/hcode-afs-smoke.XXXXXX")"
cleanup() {
  rm -rf -- "$fixture"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM
mkdir -p "$fixture/home" "$fixture/xdg" "$fixture/workspace"
dir="$fixture/project"
mkdir -p "$dir"
git -C "$dir" init -q
central="$fixture/context"
config="$fixture/config.toml"
quote() {
  bun -e 'process.stdout.write(JSON.stringify(process.argv[1]))' "$1"
}
cat >"$config" <<EOF
[general]
context_root = $(quote "$central")
mcp_allowed_roots = [$(quote "$central"), $(quote "$dir")]
EOF
export HOME="$fixture/home"
export XDG_CONFIG_HOME="$fixture/xdg"
export OPENCODE_CONFIG_DIR="$ROOT/.opencode"
export SC_WORKSPACE_ROOT="$fixture/workspace"
export AFS_CONFIG_PATH="$config"
export AFS_DEFAULT_AGENTS="off"
export AFS_MCP_TOOL_CATALOG="slim"
export AFS_BIN="$afs_cli"
export AFS_CLI="$afs_cli"

run() {
  HALEXT_HCODE_DIRECTORY="$dir" "$ROOT/scripts/hcode" "$@"
}

grab() {
  local out
  if ! out="$(run "$@" 2>&1)"; then
    printf '%s\n' "$out" >&2
    return 1
  fi
  printf '%s' "$out"
}

json_get() {
  local key="$1"
  local raw="$2"
  bun -e 'const d = JSON.parse(process.argv[1]); const k = process.argv[2].split("."); let x = d; for (const p of k) x = x?.[p]; if (x === undefined || x === null) process.exit(1); process.stdout.write(String(x))' "$raw" "$key"
}

say() {
  printf '%s\n' "$*" >&2
}

help_for() {
  local out
  if ! out="$("$afs_cli" "$@" --help 2>&1)"; then
    printf 'AFS CLI contract failed for %s: %s\n' "$*" "$out" >&2
    return 1
  fi
  printf '%s' "$out"
}

require_flag() {
  local label="$1"
  local flag="$2"
  local help="$3"
  if ! grep -Fq -- "$flag" <<<"$help"; then
    printf 'expected %s help to expose %s\n' "$label" "$flag" >&2
    return 1
  fi
}

say "smoke: checking AFS attention and schema CLI contracts"
mission_label="missions list"
if ! mission_help="$("$afs_cli" missions list --help 2>/dev/null)"; then
  mission_label="mission list (compatibility)"
  mission_help="$(help_for mission list)"
fi
require_flag "$mission_label" "--status" "$mission_help"
require_flag "$mission_label" "--limit" "$mission_help"
require_flag "$mission_label" "--json" "$mission_help"

approval_help="$(help_for approvals approve)"
require_flag "approvals approve" "--because" "$approval_help"

schema_help="$(help_for schema validate)"
require_flag "schema validate" "--skeleton" "$schema_help"

optimize_help="$(help_for optimize decide)"
require_flag "optimize decide" "--baseline" "$optimize_help"
require_flag "optimize decide" "--candidate" "$optimize_help"
require_flag "optimize decide" "--policy" "$optimize_help"

if grep -RqsE '(/Users/[^/]+|~)/src/lab/afs/scripts/afs' \
  "$ROOT/.opencode" \
  "$ROOT/docs" \
  "$ROOT/packages/opencode/src/session/prompt"; then
  echo "prompt-layer AFS recipes must resolve the configured CLI instead of a fixed checkout" >&2
  exit 1
fi
# This checks the literal prompt recipe rather than expanding it.
# shellcheck disable=SC2016
if grep -RqsF '"${AFS_CLI:-afs}"' \
  "$ROOT/.opencode/command" \
  "$ROOT/.opencode/agent" \
  "$ROOT/.opencode/plugins/afs-context.ts" \
  "$ROOT/.opencode/skills/halext-afs/SKILL.md"; then
  echo "prompt-layer AFS recipes must honor AFS_BIN before AFS_CLI" >&2
  exit 1
fi
if ! grep -Fq 'process.env.AFS_BIN?.trim() || process.env.AFS_CLI?.trim() || "afs"' \
  "$ROOT/.opencode/plugins/afs-context.ts"; then
  echo "AFS session grounding must honor AFS_BIN, AFS_CLI, then PATH" >&2
  exit 1
fi
if ! grep -Fq '"projects", "current", "--path", base, "--json"' \
  "$ROOT/.opencode/plugins/afs-context.ts"; then
  echo "AFS plugin must resolve the central project through the CLI" >&2
  exit 1
fi
if ! grep -Fq 'args.project_path = base' "$ROOT/.opencode/plugins/afs-context.ts"; then
  echo "AFS tool calls must retain the project path for v2 scope enforcement" >&2
  exit 1
fi
if ! grep -Fq '"{env:AFS_CLI}", "mcp", "serve"' "$ROOT/.opencode/opencode.jsonc"; then
  echo "afs_local MCP must use the launcher-selected AFS_CLI" >&2
  exit 1
fi
if ! grep -Fq -- '--skeleton <human-plan.json>' "$ROOT/.opencode/agent/afs-planner.md"; then
  echo "planner must validate human_intent against the supplied skeleton" >&2
  exit 1
fi
if grep -RqsF 'scratchpad/handoffs' "$ROOT/.opencode/agent"; then
  echo "AFS agents must use immutable handoff flows instead of ad-hoc scratchpad files" >&2
  exit 1
fi
if grep -Fq '.context/scratchpad/afs_agents/session_client_' "$ROOT/.opencode/command/afs-verify.md"; then
  echo "verification guidance must use the scoped payload hint instead of a v1 storage path" >&2
  exit 1
fi

say "smoke: initializing isolated central context"
"$afs_cli" context init --layout-version 2 --path "$dir" --context-root "$central" >/dev/null
project="$("$afs_cli" projects current --path "$dir" --json)"
layout="$(json_get layout_version "$project")"
registered="$(json_get registered "$project")"
scope="$(json_get scope_id "$project")"
if [[ "$layout" != "2" || "$registered" != "true" || "$scope" != project:* ]]; then
  echo "expected an isolated registered v2 project, got layout=$layout registered=$registered scope=$scope" >&2
  exit 1
fi
root="$(json_get context_root "$project")"
project_id="$(json_get project.project_id "$project")"
scratchpad="$root/scratchpad/projects/$project_id"

say "smoke: warming isolated hcode state"
run debug agent build >/dev/null 2>&1

say "smoke: checking central-context AFS status hook"
status="$(grab debug agent build --tool afs_local_context_status --params '{}')"
ctx="$(json_get result.structuredContent.context_path "$status")"
if [[ "$ctx" != "$root" ]]; then
  echo "expected context_path $root, got $ctx" >&2
  exit 1
fi

say "smoke: checking central context file-path normalization"
list="$(grab debug agent build --tool afs_local_context_list --params '{"path":"scratchpad","max_depth":1}')"
list_path="$(json_get result.structuredContent.path "$list")"
if [[ "$list_path" != "$scratchpad" ]]; then
  echo "expected normalized scratchpad path $scratchpad, got $list_path" >&2
  exit 1
fi

say "smoke: checking default context read/write tools"
note=".context/scratchpad/afs_hcode_smoke.md"
body="hcode smoke: default AFS context tools"
write="$(grab debug agent build --tool afs_local_context_write --params "{\"path\":\"$note\",\"content\":\"$body\\n\",\"mkdirs\":true}")"
write_path="$(json_get result.structuredContent.path "$write")"
if [[ "$write_path" != "$scratchpad/afs_hcode_smoke.md" ]]; then
  echo "expected normalized write path under $scratchpad, got $write_path" >&2
  exit 1
fi

read="$(grab debug agent build --tool afs_local_context_read --params "{\"path\":\"$note\"}")"
read_text="$(json_get result.structuredContent.content "$read")"
if [[ "$read_text" != "$body" ]]; then
  echo "expected smoke note readback, got $read_text" >&2
  exit 1
fi

say "smoke: checking full-catalog file alias scoping"
legacy="$(AFS_MCP_TOOL_CATALOG=full grab debug agent build --tool afs_local_fs_list --params '{"path":"scratchpad","max_depth":1}')"
legacy_path="$(json_get result.structuredContent.path "$legacy")"
if [[ "$legacy_path" != "$scratchpad" ]]; then
  echo "expected full-catalog alias under $scratchpad, got $legacy_path" >&2
  exit 1
fi

if [[ "$live" == "1" ]]; then
  say "smoke: running live slash-command path"
  run run "/afs-brief" >/dev/null
  run run "/afs-status" >/dev/null
fi

say "smoke: passed for $target"
