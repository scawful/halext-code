{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/gguf/zelda/nayru-v9-q8_0.gguf",
  "small_model": "lmstudio/gguf/zelda/scribe-3b-v2-q4km.gguf",
  "provider": {
    "opencode": {
      "options": {},
    },
    // LM Studio on MacBook M5 - dynamically discovers available models
    // Models are served at http://localhost:1234/v1
    "lmstudio": {
      "api": "http://localhost:1234/v1",
      "options": {
        "discoverModels": true,
        "discoverModelsTimeout": 8000,
      },
      // Whitelist the curated local runtime set for hcode.
      // Excludes embeddings, throwaway aliases, and broken experiments.
      "whitelist": [
        "gguf/zelda/nayru-v9-q8_0.gguf",
        "gguf/zelda/farore-7b-v5-q8.gguf",
        "gguf/zelda/din-7b-v4-q4km.gguf",
        "gguf/zelda/veran-7b-v4-q8.gguf",
        "gguf/zelda/majora-7b-v2-q8.gguf",
        "gguf/zelda/hylia-v3-q8_0.gguf",
        "gguf/zelda/scribe-3b-v2-q4km.gguf",
        "oracle-tools-7b",
        "scawful@q4_k_m",
        "scawful@q8",
        "scawfulbot-qwen3-8b-v1",
        "gguf/scawful/scawful-echo-qwen25-7b-v4-q4km.gguf",
        "gguf/scawful/muse-3b-v2-q4km.gguf",
        "scawful-echo-mlx",
        "gguf/ollama/qwen2.5-coder-7b.gguf",
      ],
    },
    "windows": {
      "options": {
        "discoverModels": true,
        "discoverModelsTimeout": 8000,
      },
    },
  },
  // This workspace lives inside /Users/scawful/src/lab and relies on the
  // sibling afs and afs-scawful repos for AFS behavior and skills.
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny",
    },
    "skill": {
      "*": "allow",
    },
    "afs_local_*": "allow",
    "sequential_thinking_*": "allow",
    "yaze_*": "allow",
    "websearch": "allow",
    "webfetch": "allow",
  },
  "mcp": {
    // Agentic File System for slim default context tools. Use
    // AFS_MCP_TOOL_CATALOG=full only for explicit debug/admin sessions.
    "afs_local": {
      "type": "local",
      "command": ["/Users/scawful/src/lab/afs/scripts/afs", "mcp", "serve"],
      "enabled": true,
      "timeout": 30000,
    },
    // Sequential thinking for complex multi-step reasoning
    "sequential_thinking": {
      "type": "local",
      "command": ["node", "/Users/scawful/src/tools/mcp-servers/src/sequentialthinking/dist/index.js"],
      "enabled": true,
      "timeout": 60000,
    },
    // Yaze MCP for SNES/Z80 emulation debugging (requires running YAZE emulator with gRPC)
    "yaze": {
      "type": "local",
      "command": [
        "/Users/scawful/src/tools/yaze-mcp/venv/bin/python",
        "/Users/scawful/src/tools/yaze-mcp/server.py"
      ],
      "environment": {
        "PYTHONPATH": "/Users/scawful/src/tools/yaze-mcp",
        "YAZE_GRPC_TARGET": "127.0.0.1:50052",
      },
      "enabled": false,
      "timeout": 30000,
    },
  },
  "skills": {
    "paths": ["/Users/scawful/src/lab/afs-scawful/skills"],
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
