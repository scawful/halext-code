{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.1-codex-mini",
  "provider": {
    "opencode": {
      "options": {},
    },
    "lmstudio": {
      "options": {
        "discoverModels": true,
        "discoverModelsTimeout": 8000,
      },
    },
    "windows": {
      "options": {
        "discoverModels": true,
        "discoverModelsTimeout": 8000,
      },
    },
  },
  // This workspace lives inside /Users/scawful/src/lab and relies on the
  // sibling afs and afs-scawful repos for AFS behavior and skills.
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny",
    },
    "skill": {
      "*": "allow",
    },
    "afs_local_*": "allow",
    "websearch": "allow",
    "webfetch": "allow",
  },
  "mcp": {
    "afs_local": {
      "type": "local",
      "command": ["/Users/scawful/src/lab/afs/scripts/afs", "mcp", "serve"],
      "enabled": true,
      "timeout": 30000,
    },
  },
  "skills": {
    "paths": ["/Users/scawful/src/lab/afs-scawful/skills"],
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
