{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  // AFS is resolved from PATH so this checkout does not encode one machine's
  // source-tree layout. Override this entry in user config when AFS is exposed
  // by another executable or transport.
  "mcp": {
    "afs": {
      "type": "local",
      "command": ["afs", "mcp", "serve"],
      "enabled": true,
      "timeout": 30000,
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
